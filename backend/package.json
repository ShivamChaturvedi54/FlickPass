{
  "name": "flickpass-backend",
  "version": "1.0.0",
  "description": "FlickPass Movie Ticket Booking API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ignore data/ src/server.js",
    "start": "node src/server.js",
    "seed": "node prisma/seed.js",
    "db:generate": "node node_modules/prisma/dist/prisma.js generate",
    "db:migrate": "node node_modules/prisma/dist/prisma.js migrate dev --name init",
    "db:push": "node node_modules/prisma/dist/prisma.js db push",
    "db:studio": "node node_modules/prisma/dist/prisma.js studio",
    "db:reset": "node node_modules/prisma/dist/prisma.js migrate reset --force"
  },
  "keywords": [
    "movie",
    "booking",
    "tickets"
  ],
  "author": "FlickPass",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "prisma": "^8.0.0-rc.21",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0",
    "uuid": "^14.0.2"
  }
}
